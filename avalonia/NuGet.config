<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The terminal control (Iciclecreek.Avalonia.Terminal) is consumed from a local
    feed that carries a patched 4.1.2 build. 4.1.1 pinned full-width (CJK)
    characters to exactly two cell advances in the glyph fast path so mixed
    CJK+Latin lines stay aligned on the grid regardless of the fallback font's
    natural metrics (round 33). 4.1.2 additionally resolves the CJK glyph from
    the fallback face down the family chain and pins it to the PRIMARY face's
    baseline, so the Chinese sits level with the Latin beside it rather than a
    line lower (round 43). 4.1.3 adds select-to-copy (MobaXterm parity): completing a
    mouse selection copies the text to the clipboard on pointer release
    (TerminalView.AutoCopyOnSelection, default on; round 45). 4.1.4 adds path-aware
    double-click (double-clicking a path selects the whole path) and a text-beam
    (IBeam) pointer over the terminal surface (round 47). The nupkg is committed
    under third_party/ so the build is self-contained; see
    avalonia/pack/PLAN-macro-round.md rounds 33, 43, 45 and 47.
  -->
  <packageSources>
    <clear />
    <add key="local-iciclecreek" value="third_party/iciclecreek" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
