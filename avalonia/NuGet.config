<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The terminal control (Iciclecreek.Avalonia.Terminal) is consumed from a local
    feed that carries a patched 4.1.1 build. The patch pins full-width (CJK)
    characters to exactly two cell advances in the glyph fast path so mixed
    CJK+Latin lines stay aligned on the grid regardless of the fallback font's
    natural metrics (round 33). The nupkg is committed under third_party/ so the
    build is self-contained; see avalonia/pack/PLAN-macro-round.md round 33.
  -->
  <packageSources>
    <clear />
    <add key="local-iciclecreek" value="third_party/iciclecreek" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
