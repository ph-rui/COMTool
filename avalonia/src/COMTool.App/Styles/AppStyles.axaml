<Styles x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:terminal="using:Iciclecreek.Terminal">

  <!-- r67.7：MobaXterm 式终端滚动条。
       库模板里本来就有 PART_ScrollBar（Grid *,Auto），但 Fluent 的滚动条平时
       全透明、只在悬停时浮现，我们此前干脆把它隐藏（Width=0），所以终端右侧
       什么都没有。这里换成固定 16px、始终可见的经典滚动条：浅灰轨道 +
       满宽滑块 + 上下箭头，按住轨道空白区由 RepeatButton 自动重复翻页。 -->
  <Styles.Resources>
    <ControlTheme x:Key="TerminalScrollBarThumbTheme" TargetType="Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinHeight" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Background" Value="{DynamicResource TerminalScrollBarThumbBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource TerminalScrollBarThumbHoverBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource TerminalScrollBarThumbPressedBrush}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="TerminalScrollBarButtonTheme" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TerminalScrollBarArrowBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource TerminalScrollBarButtonHoverBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource TerminalScrollBarButtonPressedBrush}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="TerminalScrollBarTheme" TargetType="ScrollBar">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="{DynamicResource TerminalScrollBarTrackBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="16,*,16" Background="{TemplateBinding Background}">
            <RepeatButton Name="PART_LineUpButton"
                          Grid.Row="0"
                          Theme="{StaticResource TerminalScrollBarButtonTheme}"
                          AutomationProperties.Name="Line up">
              <PathIcon Data="M 19.091797 14.970703 L 10 5.888672 L 0.908203 14.970703 L 0.029297 14.091797 L 10 4.111328 L 19.970703 14.091797 Z"
                        Width="8" Height="8" />
            </RepeatButton>
            <Track Grid.Row="1"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton"
                              Theme="{StaticResource TerminalScrollBarButtonTheme}"
                              AutomationProperties.Name="Page up" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton"
                              Theme="{StaticResource TerminalScrollBarButtonTheme}"
                              AutomationProperties.Name="Page down" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource TerminalScrollBarThumbTheme}"
                     AutomationProperties.Name="Position" />
            </Track>
            <RepeatButton Name="PART_LineDownButton"
                          Grid.Row="2"
                          Theme="{StaticResource TerminalScrollBarButtonTheme}"
                          AutomationProperties.Name="Line down">
              <PathIcon Data="M 18.935547 4.560547 L 19.814453 5.439453 L 10 15.253906 L 0.185547 5.439453 L 1.064453 4.560547 L 10 13.496094 Z"
                        Width="8" Height="8" />
            </RepeatButton>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="terminal|TerminalControl ScrollBar">
    <Setter Property="Theme" Value="{StaticResource TerminalScrollBarTheme}" />
  </Style>

  <Style Selector="Button.TitleBarButton, ToggleButton.TitleBarButton">
    <Setter Property="Width" Value="35" />
    <Setter Property="Height" Value="35" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
  </Style>

  <Style Selector="Button.TitleBarButton:pointerover, ToggleButton.TitleBarButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.TitleBarButton:checked">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToggleButton.TitleBarButton:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>

  <Style Selector="Button.WindowMinButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MinimizeHoverBrush}" />
  </Style>
  <Style Selector="Button.WindowMaxButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MaximizeHoverBrush}" />
  </Style>
  <Style Selector="Button.WindowCloseButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
    <!-- Win10 式关闭悬停（红底）配白色字形；浅色主题下红底压不住深色字形。 -->
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.PinButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.PinButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>

  <Style Selector="Button.EmptyAddButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.EmptyAddButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <Style Selector="Button.SidebarAddButton">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SidebarAddButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>

  <!-- MobaXterm-style sidebar icon rail cells. -->
  <Style Selector="Button.RailButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.RailButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource SidebarRailActiveBrush}" />
  </Style>
  <Style Selector="Button.RailButton.active">
    <Setter Property="Background" Value="{DynamicResource SidebarRailActiveBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- MobaXterm-style macro record button: full-width, subtle border. -->
  <Style Selector="Button.MacroRecordButton">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource SidebarListBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MacroRecordButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource SidebarRailActiveBrush}" />
  </Style>
  <Style Selector="Button.MacroRecordButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- A saved-macro row: hover highlight for click/double-click. -->
  <Style Selector="Border.MacroRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.MacroRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource SidebarRailActiveBrush}" />
  </Style>

  <!-- Ctrl+Space popup rows. -->
  <Style Selector="Button.MacroPopupRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.MacroPopupRow:pointerover">
    <Setter Property="Background" Value="#cfe3ff" />
  </Style>

  <!-- Sidebar sub-panels (Tools / Macros). -->
  <Style Selector="Border.SidebarCard">
    <Setter Property="Background" Value="{DynamicResource SidebarListBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="TextBlock.SidebarFieldLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarSectionBrush}" />
  </Style>
  <Style Selector="TextBlock.SidebarError">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="#c62828" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.SidebarDetail">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource SessionDetailBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.SidebarActionButton">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.SidebarActionButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.SidebarActionButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Button.SidebarTextButton">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.SidebarTextButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>
  <Style Selector="Button.SidebarIconButton">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SidebarIconButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>

  <!-- Tools menu entry (MobaXterm-style dropdown item) -->
  <Style Selector="Button.ToolMenuItemButton">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
  </Style>
  <Style Selector="Button.ToolMenuItemButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
  </Style>
  <Style Selector="Button.ToolMenuItemButton:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Scan result grid row (host x port cells) -->
  <Style Selector="StackPanel.ScanRow">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="StackPanel.ScanRow.selected">
    <Setter Property="Background" Value="{DynamicResource SidebarRailActiveBrush}" />
  </Style>

  <!-- r54: MobaXterm 标签——未选中白底 #b4b4b4 细边深字；选中深灰竖向渐变 + 白字
       （用户参照图 + 实机双 tab 截屏取证，见 PLAN 54）。 -->
  <Style Selector="Border.TabItemBorder">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="Padding" Value="14,0,8,0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Background" Value="{DynamicResource TabUnselectedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabUnselectedBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
  </Style>
  <Style Selector="Border.TabItemBorder.selected">
    <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabSelectedBorderBrush}" />
  </Style>
  <!-- r67：拖动换位中的标签半透明提示 -->
  <Style Selector="Border.TabItemBorder.dragging">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.TabKindIcon">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- r48 后图标颜色恒定：TerminalTab.KindIconBrush 按类型返回固定色（SSH 金、
       串口绿……），选中与否都不变，与 MobaXterm 一致（选中 tab 只换底色）。 -->
  <Style Selector="TextBlock.TabTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
  </Style>
  <Style Selector="Border.TabItemBorder.selected TextBlock.TabTitle">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.TabClose">
    <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
  </Style>
  <Style Selector="Border.TabItemBorder.selected TextBlock.TabClose">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- r54: MobaXterm 的关闭符是裸 ✕（白×于深色选中 tab、深×于浅色未选中 tab），
       去掉原先的浅蓝药丸底；悬停仅给轻量底色反馈。 -->
  <Style Selector="Button.TabCloseButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.TabCloseButton:pointerover">
    <Setter Property="Background" Value="#d9d9d9" />
  </Style>
  <Style Selector="Border.TabItemBorder.selected Button.TabCloseButton:pointerover">
    <Setter Property="Background" Value="#5a5a5a" />
  </Style>

  <Style Selector="TextBlock.EmptyTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.SidebarTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarTitleBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.SessionName">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SessionNameBrush}" />
  </Style>

  <Style Selector="TextBlock.SessionDetail">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource SessionDetailBrush}" />
  </Style>

  <Style Selector="TextBlock.SessionConnecting">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#1565c0" />
  </Style>

  <Style Selector="TextBlock.SectionHeader">
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarSectionBrush}" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox.SessionList">
    <Setter Property="Background" Value="{DynamicResource SidebarListBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
