<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#212121" />
  <SolidColorBrush x:Key="WindowTextBrush" Color="#bcbcbd" />
  <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#212121" />
  <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#ffffff" />
  <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#273b4e" />
  <SolidColorBrush x:Key="MinimizeHoverBrush" Color="#2ba13e" />
  <SolidColorBrush x:Key="MaximizeHoverBrush" Color="#cf9001" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#df2f25" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0f88eb" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#0772ca" />
  <SolidColorBrush x:Key="SidebarTitleBrush" Color="#bcbcbd" />
  <SolidColorBrush x:Key="SidebarBorderBrush" Color="#3a3a3a" />
  <SolidColorBrush x:Key="SidebarListBackgroundBrush" Color="#2b2b2b" />
  <SolidColorBrush x:Key="SidebarSectionBrush" Color="#9e9e9e" />
  <SolidColorBrush x:Key="SessionNameBrush" Color="#e0e0e0" />
  <SolidColorBrush x:Key="SessionDetailBrush" Color="#9e9e9e" />
  <SolidColorBrush x:Key="SessionConnectedBrush" Color="#43a047" />
  <SolidColorBrush x:Key="SessionDisconnectedBrush" Color="#757575" />
  <SolidColorBrush x:Key="SidebarRailBackgroundBrush" Color="#262626" />
  <SolidColorBrush x:Key="SidebarRailActiveBrush" Color="#3a3a3a" />
  <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#2b2b2b" />
  <SolidColorBrush x:Key="TabSelectedBrush" Color="#0f88eb" />
  <SolidColorBrush x:Key="TabForegroundBrush" Color="#0f88eb" />

  <FontFamily x:Key="IconFontAwesome">avares://COMTool.App/Assets/Fonts/fontawesome6-solid.ttf#Font Awesome 6 Free Solid</FontFamily>
  <FontFamily x:Key="IconMaterialDesign">avares://COMTool.App/Assets/Fonts/materialdesignicons6.ttf#Material Design Icons</FontFamily>
  <FontFamily x:Key="IconPhosphor">avares://COMTool.App/Assets/Fonts/phosphor.ttf#Phosphor</FontFamily>
  <FontFamily x:Key="UiFontFamily">DejaVu Sans</FontFamily>
</ResourceDictionary>
