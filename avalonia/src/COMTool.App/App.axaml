<Application x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:COMTool.App.Styles"
             x:Class="COMTool.App.App"
             RequestedThemeVariant="Light">

  <!-- r52 (AOT): 原来用 ResourceInclude 按 URI 动态加载 ThemeLight.axaml，
       Native AOT 下运行时 XAML 解析被裁剪，ResourceInclude.get_Loaded 抛
       "No precompiled XAML found"。改为直接实例化带 x:Class 的 ThemeLight
       （构造函数走 AvaloniaXamlLoader.Load(this) 预编译路径，AOT/JIT 均可用）。
       ThemeManager.Apply 在启动后仍会按配置替换为 Light/Dark。 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <local:ThemeLight />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://COMTool.App/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
