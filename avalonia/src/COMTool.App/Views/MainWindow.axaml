<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:COMTool.App.ViewModels"
        xmlns:views="using:COMTool.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="850" d:DesignHeight="500"
        x:Class="COMTool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="850" Height="500"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        Icon="/Assets/logo.ico"
        Title="COMTool v0.01"
        CanResize="True"
        WindowDecorations="None">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid Name="RootGrid"
        RowDefinitions="35,*"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Custom title bar: logo, title, pin, session toggle, window buttons. -->
    <Border Grid.Row="0"
            Name="TitleBar"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Light theme" Click="OnLightThemeClick" />
          <MenuItem Header="Dark theme" Click="OnDarkThemeClick" />
          <Separator />
          <MenuItem Header="About COMTool" Click="OnAboutClick" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid ColumnDefinitions="40,104,40,35,*,35,35,35">
        <Image Grid.Column="0"
               Name="TitleBarLogo"
               Source="/Assets/logo.png"
               Width="35" Height="35"
               Margin="5,0,0,0"
               Stretch="Uniform" />
        <TextBlock Grid.Column="1"
                   Text="COMTool v0.01"
                   Foreground="{DynamicResource TitleBarForegroundBrush}"
                   FontSize="12"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="PinButton"
                Classes="PinButton"
                ToolTip.Tip="Always on top"
                Click="OnPinClick">
          <TextBlock Name="PinIcon"
                     Text="&#xf670;"
                     FontFamily="{DynamicResource IconPhosphor}"
                     FontSize="16"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="3"
                Name="SessionsButton"
                Classes="TitleBarButton"
                ToolTip.Tip="Show/hide sessions"
                Click="OnSessionsToggle">
          <TextBlock Text="&#xf03a;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="18"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>

        <Button Grid.Column="5"
                Classes="TitleBarButton WindowMinButton"
                ToolTip.Tip="Minimize"
                Click="OnMinimizeClick">
          <TextBlock Text="&#xF1639;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="6"
                Name="MaximizeButton"
                Classes="TitleBarButton WindowMaxButton"
                ToolTip.Tip="Maximize"
                Click="OnMaximizeClick">
          <TextBlock Name="MaximizeIcon"
                     Text="&#xF05AF;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="7"
                Classes="TitleBarButton WindowCloseButton"
                ToolTip.Tip="Close"
                Click="OnCloseClick">
          <TextBlock Text="&#xF05AD;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Name="BodyGrid"
          Margin="16,0,10,10"
          ColumnDefinitions="220,3,*">
      <views:SessionSidebar Grid.Column="0"
                            Name="Sidebar" />

      <GridSplitter Grid.Column="1"
                    Name="SidebarSplitter"
                    Width="3"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    DragCompleted="OnSidebarSplitterDragCompleted" />

      <Grid Grid.Column="2" Margin="16,0,0,0">
        <Grid Name="MainStack">
          <!-- Empty state mirrors main2.py: one part above, two parts below. -->
          <Grid Name="EmptyState"
                RowDefinitions="*,20,6,20,6,32,2*"
                IsVisible="{Binding !HasTabs}"
                Margin="0,3,0,0">
            <TextBlock Grid.Row="1"
                       Classes="EmptyTitle"
                       Text="Select a session from the left"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="3"
                       Name="EmptyStateAddHint"
                       Classes="EmptyTitle"
                       Text="or click + to add a session"
                       VerticalAlignment="Center" />
            <Button Grid.Row="5"
                    Name="EmptyAddSessionButton"
                    Classes="EmptyAddButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="New session">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf1e6;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#43a047"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf233;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#1976d2"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf120;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#00897b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf0ac;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#f57c00"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf108;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#607d8b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
              <TextBlock Text="&#xf067;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="14"
                         Foreground="White" />
            </Button>
          </Grid>

          <Grid Name="TabHost"
                IsVisible="{Binding HasTabs}"
                RowDefinitions="36,*">
            <Grid Grid.Row="0" Height="36" ColumnDefinitions="27,*,Auto">
              <Button Grid.Column="0"
                      Width="27" Height="27"
                      MinWidth="0" MinHeight="0"
                      Padding="0"
                      Margin="0,3,0,0"
                      Background="{DynamicResource AccentBrush}"
                      BorderThickness="0"
                      CornerRadius="5"
                      Focusable="False"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="Settings"
                      Click="OnSettingsClick">
                <TextBlock Text="&#xf013;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="16"
                           Foreground="White" />
              </Button>

              <ItemsControl Grid.Column="1"
                            ItemsSource="{Binding Tabs}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TerminalTab">
                    <Border Classes="TabItemBorder"
                            Classes.selected="{Binding IsSelected}"
                            Focusable="False"
                            PointerPressed="OnTabPointerPressed"
                            DoubleTapped="OnTabDoubleTapped"
                            ToolTip.Tip="Double click to detach as a window"
                            Tag="{Binding}">
                      <StackPanel Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding TabDotBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Classes="TabTitle"
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center" />
                        <Button Classes="TabCloseButton"
                                Width="16" Height="16"
                                MinWidth="0" MinHeight="0"
                                Padding="0"
                                Tag="{Binding}"
                                Click="OnCloseTabClick">
                          <Image Source="/Assets/close.png"
                                 Width="10" Height="10" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="0"
                          Margin="0,3,0,0"
                          VerticalAlignment="Top">
                <Button Name="ToolbarAddSessionButton"
                        Width="32" Height="32"
                        MinWidth="0" MinHeight="0"
                        Padding="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        CornerRadius="5"
                        Focusable="False"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="New session">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionClick">
                        <MenuItem.Icon>
                          <TextBlock Text="&#xf1e6;"
                                     FontFamily="{DynamicResource IconFontAwesome}"
                                     FontSize="14"
                                     Foreground="#43a047"
                                     VerticalAlignment="Center" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionClick">
                        <MenuItem.Icon>
                          <TextBlock Text="&#xf233;"
                                     FontFamily="{DynamicResource IconFontAwesome}"
                                     FontSize="14"
                                     Foreground="#1976d2"
                                     VerticalAlignment="Center" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionClick">
                        <MenuItem.Icon>
                          <TextBlock Text="&#xf120;"
                                     FontFamily="{DynamicResource IconFontAwesome}"
                                     FontSize="14"
                                     Foreground="#00897b"
                                     VerticalAlignment="Center" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionClick">
                        <MenuItem.Icon>
                          <TextBlock Text="&#xf0ac;"
                                     FontFamily="{DynamicResource IconFontAwesome}"
                                     FontSize="14"
                                     Foreground="#f57c00"
                                     VerticalAlignment="Center" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionClick">
                        <MenuItem.Icon>
                          <TextBlock Text="&#xf108;"
                                     FontFamily="{DynamicResource IconFontAwesome}"
                                     FontSize="14"
                                     Foreground="#607d8b"
                                     VerticalAlignment="Center" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                  <TextBlock Text="&#xf067;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="16"
                             Foreground="White" />
                </Button>
                <ComboBox Name="EncodingCombo"
                          Classes="EncodingCombo"
                          Width="97" Height="31"
                          MinWidth="60"
                          VerticalAlignment="Top"
                          SelectionChanged="OnEncodingChanged"
                          DropDownClosed="OnEncodingDropDownClosed">
                  <ComboBoxItem Content="ASCII" />
                  <ComboBoxItem Content="UTF-8" />
                  <ComboBoxItem Content="UTF-16" />
                  <ComboBoxItem Content="GBK" />
                  <ComboBoxItem Content="GB2312" />
                  <ComboBoxItem Content="GB18030" />
                </ComboBox>
                <Button Width="31" Height="31"
                        MinWidth="0" MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Focusable="False"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Functional"
                        Click="OnFunctionalClick">
                  <Image Source="/Assets/arrow-right.png"
                         Width="31" Height="31" />
                </Button>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*,6,30">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="9">
                  <ContentControl Name="TabContentHost"
                                  Content="{Binding SelectedTab.Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                </Border>

                <Border Grid.Column="1"
                        Name="FunctionalPanel"
                        Width="180"
                        IsVisible="{Binding SelectedTab.IsFunctionalVisible}"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="0,3,3,0">
                  <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Functional"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarTitleBrush}" />
                    <Button Content="Load config"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnLoadConfigClick" />
                    <Button Content="Share config"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnShareConfigClick" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedTab.StatusMessage}"
                           FontSize="12"
                           Foreground="{Binding SelectedTab.StatusBrush}"
                           Margin="4,0,4,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedTab.IsZmodemActive}">
                  <TextBlock Text="{Binding SelectedTab.ZmodemLabel}"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <ProgressBar Width="150"
                               Height="14"
                               MinWidth="0"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding SelectedTab.ZmodemProgress}"
                               IsIndeterminate="{Binding SelectedTab.IsZmodemIndeterminate}"
                               ShowProgressText="{Binding SelectedTab.IsZmodemProgressTextVisible}"
                               VerticalAlignment="Center" />
                  <Button Content="Cancel"
                          Width="90"
                          Height="24"
                          MinHeight="0"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          IsEnabled="{Binding SelectedTab.IsZmodemCancellable}"
                          Click="OnZmodemCancelClick" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="1"
            Name="SessionHoverStrip"
            ZIndex="9"
            Width="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Margin="6,0,0,10"
            Background="Transparent"
            IsVisible="False"
            PointerEntered="OnSessionHoverStripEntered" />

    <Button Grid.Row="1"
            Name="SessionHandle"
            Classes="SessionHandle"
            ZIndex="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="6,0,0,10"
            ToolTip.Tip="Show/hide sessions"
            PointerEntered="OnSessionHandlePointerEntered"
            Click="OnSessionHandleClick">
      <TextBlock Name="SessionHandleIcon"
                 Text="&#xf053;"
                 FontFamily="{DynamicResource IconFontAwesome}"
                 FontSize="7"
                 Foreground="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Button>
  </Grid>
</Window>
