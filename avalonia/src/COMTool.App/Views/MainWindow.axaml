<Window x:CompileBindings="True" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:COMTool.App.ViewModels"
        xmlns:views="using:COMTool.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="850" d:DesignHeight="500"
        x:Class="COMTool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="850" Height="500"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        Icon="/Assets/logo.ico"
        Title="COMTool v0.01"
        CanResize="True"
        WindowDecorations="None">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <!-- 状态栏远程监控分段盒子（MobaXterm 风格：每指标一个带图标的独立小格）。 -->
    <Style Selector="Border.MonSeg">
      <Setter Property="Background" Value="{DynamicResource MonSegBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MonSegBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.MonSegText">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.MonIcon">
      <Setter Property="FontFamily" Value="{DynamicResource IconFontAwesome}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MonIconBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- DataTemplate 内的内联 DynamicResource 在模板实例化时可能解析不到主题资源
         （实测回退成 MonIconBrush 灰），因此这里用类样式声明分区图标与热分区配色。 -->
    <Style Selector="TextBlock.MonIconDisk">
      <Setter Property="Foreground" Value="{DynamicResource MonIconDiskBrush}" />
    </Style>
    <Style Selector="TextBlock.MonSegHot">
      <Setter Property="Foreground" Value="{DynamicResource MonSegHotBrush}" />
      <!-- 高占用分区只换颜色：MobaXterm 22.1 实样是橙红常规字重正体（并排对照图
           2026-10-30 复核），不加粗、不斜体。斜体尤其危险：微软雅黑没有真斜体，
           Italic 会让 Skia 现场合成字形（TryCreateSyntheticGlyphTypeface →
           sk_stream_read），在 Windows 上触发 0xc0000005 崩溃（实机 dump 定位）。 -->
    </Style>
  </Window.Styles>

  <Grid Name="RootGrid"
        RowDefinitions="35,*"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Custom title bar: logo, title, pin, window buttons.
         r55: the sessions toggle button was removed from the title bar per
         user feedback (MobaXterm has no such button); the docked sidebar is
         toggled through the rail sessions icon instead. A 1px bottom divider
         (TitleBarBorderBrush) separates the title bar band from the content. -->
    <Border Grid.Row="0"
            Name="TitleBar"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Light theme" Click="OnLightThemeClick" />
          <MenuItem Header="Dark theme" Click="OnDarkThemeClick" />
          <Separator />
          <MenuItem Header="About COMTool" Click="OnAboutClick" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid ColumnDefinitions="40,104,40,*,35,35,35">
        <!-- r67.4：28px → 30px（用户反馈图标偏小、边缘发虚：logo.png 内建 5.5%
             透明边距，28px 槽内有效图形仅 ~24px），Margin 上下 2.5 精确居中，
             与标题文字视觉中心（~17px @35px 栏高）对齐。 -->
        <Image Grid.Column="0"
               Name="TitleBarLogo"
               Source="/Assets/logo.png"
               Width="30" Height="30"
               Margin="6,2.5,0,2.5"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform" />
        <TextBlock Grid.Column="1"
                   Text="COMTool v0.01"
                   Foreground="{DynamicResource TitleBarForegroundBrush}"
                   FontSize="12"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="PinButton"
                Classes="PinButton"
                ToolTip.Tip="Always on top"
                Click="OnPinClick">
          <TextBlock Name="PinIcon"
                     Text="&#xf670;"
                     FontFamily="{DynamicResource IconPhosphor}"
                     FontSize="16"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="4"
                Classes="TitleBarButton WindowMinButton"
                ToolTip.Tip="Minimize"
                Click="OnMinimizeClick">
          <TextBlock Text="&#xF1639;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="5"
                Name="MaximizeButton"
                Classes="TitleBarButton WindowMaxButton"
                ToolTip.Tip="Maximize"
                Click="OnMaximizeClick">
          <TextBlock Name="MaximizeIcon"
                     Text="&#xF05AF;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="6"
                Classes="TitleBarButton WindowCloseButton"
                ToolTip.Tip="Close"
                Click="OnCloseClick">
          <TextBlock Text="&#xF05AD;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- Left margin is 0 so the sidebar (and its icon rail) sits flush on the
         window edge, MobaXterm-style. The content column carries the 32px left
         inset itself, keeping the terminal and tab strip in the same absolute
         position as before (E2E coordinates unchanged). -->
    <Grid Grid.Row="1"
          Name="BodyGrid"
          Margin="0,0,10,10"
          ColumnDefinitions="260,3,*">
      <views:SessionSidebar Grid.Column="0"
                            Name="Sidebar" />

      <GridSplitter Grid.Column="1"
                    Name="SidebarSplitter"
                    Width="3"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    DragCompleted="OnSidebarSplitterDragCompleted" />

      <Grid Grid.Column="2" Name="ContentArea" Margin="32,0,0,0">
        <Grid Name="MainStack">
          <!-- Empty state mirrors main2.py: one part above, two parts below. -->
          <Grid Name="EmptyState"
                RowDefinitions="*,20,6,20,6,32,2*"
                IsVisible="{Binding !HasTabs}"
                Margin="0,3,0,0">
            <TextBlock Grid.Row="1"
                       Classes="EmptyTitle"
                       Text="Select a session from the left"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="3"
                       Name="EmptyStateAddHint"
                       Classes="EmptyTitle"
                       Text="or click + to add a session"
                       VerticalAlignment="Center" />
            <Button Grid.Row="5"
                    Name="EmptyAddSessionButton"
                    Classes="EmptyAddButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="New session">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf1e6;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#43a047"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf084;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#f0b429"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf120;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#00897b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf0ac;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#f57c00"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf108;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#607d8b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
              <TextBlock Text="&#xf067;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="14"
                         Foreground="White" />
            </Button>
          </Grid>

          <Grid Name="TabHost"
                IsVisible="{Binding HasTabs}"
                RowDefinitions="36,*">
            <Grid Grid.Row="0" Height="36" ColumnDefinitions="*"
                  Name="TabStripGrid"
                  PointerMoved="OnTabStripPointerMoved"
                  PointerReleased="OnTabStripPointerReleased"
                  PointerCaptureLost="OnTabStripPointerCaptureLost">
              <!-- r67.3：Avalonia 12 的 ItemsControl 默认 ClipToBounds=True，把标签条
                   裁到「所有标签槽位的总和」那么宽。拖动中被拖标签靠 RenderTransform
                   跟手，一旦移出这个矩形（拖最右标签继续向右 / 最左标签向左）就被
                   裁成一条缝甚至完全不可见——用户看到的就是「拖过去就消失」。
                   关闭裁剪让跟手标签恒可见（MobaXterm 同样让它浮在标签条之外）。 -->
              <ItemsControl Grid.Column="0"
                            Name="TabItemsControl"
                            ItemsSource="{Binding Tabs}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TerminalTab">
                    <Border Classes="TabItemBorder"
                            Classes.selected="{Binding IsSelected}"
                            Focusable="False"
                            PointerPressed="OnTabPointerPressed"
                            DoubleTapped="OnTabDoubleTapped"
                            ToolTip.Tip="Double click to detach as a window"
                            Tag="{Binding}">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <!-- r67.6：断开的串口标签可手动立即重连，不等 2s/5s 退避。 -->
                          <MenuItem Header="Reconnect now"
                                    IsVisible="{Binding IsSerialTab}"
                                    IsEnabled="{Binding !IsAlive}"
                                    Tag="{Binding}"
                                    Click="OnTabReconnectClick" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  Spacing="8">
                        <!-- 类型图标（MobaXterm 式：串口=插头 / SSH=钥匙 / Telnet / TCP / 本地），
                             固定 16px 宽占位，不同字形宽窄不一但标题起点仍对齐。图标颜色恒定
                             （MobaXterm 行为：选中 tab 只换底色，图标不变色；r48 按用户反馈
                             撤销 r44 的「选中变白」）。 -->
                        <TextBlock Classes="TabKindIcon"
                                   Text="{Binding KindIconGlyph}"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="13"
                                   Foreground="{Binding KindIconBrush}"
                                   Width="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Classes="TabTitle"
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center" />
                        <Button Classes="TabCloseButton"
                                Width="16" Height="16"
                                MinWidth="0" MinHeight="0"
                                Padding="0"
                                Tag="{Binding}"
                                Click="OnCloseTabClick">
                          <!-- r54: MobaXterm 式裸 ✕（选中深色 tab 上需白字，PNG 无法变色） -->
                          <TextBlock Classes="TabClose"
                                     Text="&#x2715;"
                                     FontSize="10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- r54: MobaXterm 标签条下沿的 #8b99a8 分隔线（实机截图取证）。 -->
              <Border Grid.Column="0"
                      VerticalAlignment="Bottom"
                      Height="1"
                      Background="{DynamicResource TabStripLineBrush}" />
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*,6,34">
              <Border Grid.Row="0"
                      Name="MacroStatusBanner"
                      Height="26"
                      Background="#fff3f3"
                      BorderBrush="#e03131"
                      BorderThickness="0,1,0,0"
                      IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Name="MacroBannerText"
                             FontSize="11"
                             Foreground="#c92a2a"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <!-- 20px 高的横幅按钮：Padding=0 + 11px 字号才能完整显示汉字
                       （默认 Padding 5/6 + 14px 会把字底裁掉，2026-11-03 同类缺陷排查）。 -->
                  <Button Grid.Column="1"
                          Name="MacroBannerActionButton"
                          Content="停止"
                          Width="64" MinHeight="20"
                          MinWidth="0"
                          Padding="0"
                          FontSize="11"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Margin="8,0,8,0"
                          Click="OnMacroBannerActionClick" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <!-- r54: MobaXterm 里终端几乎贴边（约 4px 间隙），边框直角；
                     间隙颜色 = 窗口底色（浅色白 / 深色 #212121）。 -->
                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="4">
                  <ContentControl Name="TabContentHost"
                                  Content="{Binding SelectedTab.Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                </Border>
                <!-- 终端查找条（TERM-23）：Ctrl+Shift+F 或终端菜单“查找”打开，
                     内联叠加在终端区底部；默认隐藏，不改变任何既有布局。 -->
                <Border Name="SearchBar"
                        IsVisible="False"
                        ZIndex="10"
                        Background="#ffffff"
                        BorderBrush="{DynamicResource SidebarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,4"
                        Height="38"
                        VerticalAlignment="Bottom"
                        Margin="9,0,9,9">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock Text="查找"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBox Name="SearchBox"
                             Width="220"
                             Watermark="输入查找文本，Enter 下一个"
                             FontSize="13"
                             TextChanged="OnSearchBoxTextChanged" />
                    <TextBlock Name="SearchCount"
                               Text=""
                               FontSize="12"
                               Foreground="#e65100"
                               VerticalAlignment="Center" />
                    <!-- Avalonia 12.1.4 Fluent Button 默认两轴 Stretch：字符串内容被
                         TextBlock 拉伸后左对齐，固定 Height=26 时内框只有 15px，Windows
                         上 12px 汉字行高约 17px → 字底被裁。故 MinHeight + 两轴居中
                         （字号/按钮高度见「字体设置」对话框同一缺陷，2026-11-03 用户反馈）。 -->
                    <Button Name="SearchPrevButton"
                            Content="上一个"
                            Width="60" MinHeight="26"
                            Padding="8,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnSearchPrevClick" />
                    <Button Name="SearchNextButton"
                            Content="下一个"
                            Width="60" MinHeight="26"
                            Padding="8,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnSearchNextClick" />
                    <Button Name="SearchCloseButton"
                            Content="关闭"
                            Width="56" MinHeight="26"
                            Padding="8,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnSearchCloseClick" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="3"
                    Name="StatusBar"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    ColumnDefinitions="Auto,*,Auto">
                <Grid.ContextMenu>
                  <ContextMenu Name="MonitorBarMenu">
                    <MenuItem Header="复制(O)" Click="OnMonitorCopyClick" />
                    <MenuItem Header="保存到文件(P)" Click="OnMonitorSaveClick" />
                    <Separator />
                    <MenuItem Header="显示主机信息(Q)" ToggleType="CheckBox" Tag="host" Click="OnMonitorOptionClick" />
                    <MenuItem Header="CPU(C)" ToggleType="CheckBox" Tag="cpu" Click="OnMonitorOptionClick" />
                    <MenuItem Header="RAM(R)" ToggleType="CheckBox" Tag="ram" Click="OnMonitorOptionClick" />
                    <MenuItem Header="网络上传(S)" ToggleType="CheckBox" Tag="netup" Click="OnMonitorOptionClick" />
                    <MenuItem Header="网络下载(T)" ToggleType="CheckBox" Tag="netdown" Click="OnMonitorOptionClick" />
                    <MenuItem Header="正常运行时间(X)" ToggleType="CheckBox" Tag="uptime" Click="OnMonitorOptionClick" />
                    <MenuItem Header="分区信息(Z)" ToggleType="CheckBox" Tag="partitions" Click="OnMonitorOptionClick" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <!-- 远程监控分段显示（MobaXterm 风格）：每指标一个带图标的盒子。
                     整串文本 MonitorText 保留，供菜单"复制/保存到文件"使用。 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0"
                            IsVisible="{Binding IsMonitorActive}">
                  <Border Name="MonSegHost" Classes="MonSeg" IsVisible="{Binding SegHostVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf108;" Classes="MonIcon"
                                 Foreground="{DynamicResource MonIconDarkBrush}" />
                      <TextBlock Text="{Binding SegHostText}" Classes="MonSegText" />
                    </StackPanel>
                  </Border>
                  <Border Name="MonSegCpu" Classes="MonSeg" IsVisible="{Binding SegCpuVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf2db;" Classes="MonIcon" Foreground="{DynamicResource MonCpuIconBrush}" />
                      <TextBlock Text="{Binding SegCpuText}" Classes="MonSegText" />
                      <Border Width="56" Height="18" CornerRadius="2" ClipToBounds="True"
                              Background="{DynamicResource MonCpuBarTrackBrush}"
                              VerticalAlignment="Center">
                        <!-- MobaXterm 的 CPU 条是示波器 roll 模式：横轴时间（28 列，
                             每列一个 2s 采样），纵轴 0~100%，新样本从右端进入。
                             每列高度=该样本百分比，颜色=该样本负载分档（低绿/中高橙/高红）。 -->
                        <ItemsControl ItemsSource="{Binding CpuColumns}"
                                      VerticalAlignment="Bottom">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="2"
                                      Height="{Binding Height}"
                                      Background="{Binding Brush}"
                                      VerticalAlignment="Bottom" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Name="MonSegRam" Classes="MonSeg" IsVisible="{Binding SegRamVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf538;" Classes="MonIcon" Foreground="{DynamicResource MonRamIconBrush}" />
                      <TextBlock Text="{Binding SegRamText}" Classes="MonSegText" />
                    </StackPanel>
                  </Border>
                  <Border Name="MonSegNetUp" Classes="MonSeg" IsVisible="{Binding SegNetUpVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf093;" Classes="MonIcon" Foreground="{DynamicResource MonNetUpIconBrush}" />
                      <TextBlock Text="{Binding SegNetUpText}" Classes="MonSegText" />
                    </StackPanel>
                  </Border>
                  <Border Name="MonSegNetDown" Classes="MonSeg" IsVisible="{Binding SegNetDownVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf019;" Classes="MonIcon" Foreground="{DynamicResource MonNetDownIconBrush}" />
                      <TextBlock Text="{Binding SegNetDownText}" Classes="MonSegText" />
                    </StackPanel>
                  </Border>
                  <Border Name="MonSegUptime" Classes="MonSeg" IsVisible="{Binding SegUptimeVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <TextBlock Text="&#xf017;" Classes="MonIcon"
                                 Foreground="{DynamicResource MonIconUptimeBrush}" />
                      <TextBlock Text="{Binding SegUptimeText}" Classes="MonSegText" />
                    </StackPanel>
                  </Border>
                  <ItemsControl Name="MonPartitions" IsVisible="{Binding SegPartitionsVisible}"
                                ItemsSource="{Binding Partitions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="MonSeg">
                          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="&#xf0a0;" Classes="MonIcon MonIconDisk"
                                       IsVisible="{Binding ShowIcon}" />
                            <TextBlock Text="{Binding Text}" Classes="MonSegText" IsVisible="{Binding !IsHot}" />
                            <TextBlock Text="{Binding Text}" Classes="MonSegText MonSegHot"
                                       IsVisible="{Binding IsHot}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedTab.StatusMessage}"
                           FontSize="12"
                           Foreground="{Binding SelectedTab.StatusBrush}"
                           Margin="4,0,4,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IsMonitorActive}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedTab.ShowStatusProgress}">
                  <TextBlock Text="{Binding SelectedTab.StatusProgressLabel}"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <ProgressBar Width="150"
                               Height="14"
                               MinWidth="0"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding SelectedTab.ZmodemProgress}"
                               IsIndeterminate="{Binding SelectedTab.StatusProgressIndeterminate}"
                               ShowProgressText="{Binding SelectedTab.ShowProgressTextVisible}"
                               VerticalAlignment="Center" />
                  <Button Content="Cancel"
                          Width="90"
                          Height="24"
                          MinHeight="0"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          IsEnabled="{Binding SelectedTab.IsZmodemCancellable}"
                          IsVisible="{Binding SelectedTab.IsZmodemActive}"
                          Click="OnZmodemCancelClick" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>

        <!-- Ctrl+Space popup: the saved-macros list floating over the content area -->
        <Border Name="MacroPopup"
                IsVisible="False"
                Width="300"
                Background="#f5f5f5"
                BorderBrush="#9aa0a6"
                BorderThickness="1"
                CornerRadius="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ZIndex="100">
          <ItemsControl Name="MacroPopupList" ItemsSource="{Binding Macros}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MacroItem">
                <Button Name="MacroPopupRow"
                        Classes="MacroPopupRow"
                        Tag="{Binding}"
                        Click="OnMacroPopupRowClick">
                  <Grid ColumnDefinitions="*,Auto" Margin="8,5">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Hotkey}"
                               FontSize="11"
                               Foreground="#9e9e9e"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Hotkey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
