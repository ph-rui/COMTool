<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:COMTool.App.ViewModels"
        xmlns:views="using:COMTool.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="850" d:DesignHeight="500"
        x:Class="COMTool.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="850" Height="500"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        Icon="/Assets/logo.ico"
        Title="COMTool v0.01"
        CanResize="True"
        WindowDecorations="None">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid Name="RootGrid"
        RowDefinitions="35,*"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Custom title bar: logo, title, pin, session toggle, window buttons. -->
    <Border Grid.Row="0"
            Name="TitleBar"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Light theme" Click="OnLightThemeClick" />
          <MenuItem Header="Dark theme" Click="OnDarkThemeClick" />
          <Separator />
          <MenuItem Header="About COMTool" Click="OnAboutClick" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid ColumnDefinitions="40,104,40,35,35,*,35,35,35">
        <Image Grid.Column="0"
               Name="TitleBarLogo"
               Source="/Assets/logo.png"
               Width="28" Height="28"
               Margin="6,3,0,4"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform" />
        <TextBlock Grid.Column="1"
                   Text="COMTool v0.01"
                   Foreground="{DynamicResource TitleBarForegroundBrush}"
                   FontSize="12"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="PinButton"
                Classes="PinButton"
                ToolTip.Tip="Always on top"
                Click="OnPinClick">
          <TextBlock Name="PinIcon"
                     Text="&#xf670;"
                     FontFamily="{DynamicResource IconPhosphor}"
                     FontSize="16"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="3"
                Name="SessionsButton"
                Classes="TitleBarButton"
                ToolTip.Tip="Show/hide sessions"
                Click="OnSessionsToggle">
          <TextBlock Text="&#xf03a;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="18"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="4"
                Name="MacroMenuButton"
                Classes="TitleBarButton"
                ToolTip.Tip="宏">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Name="MacroMenuRecordItem"
                        Header="{Binding RecordButtonText}"
                        Click="OnMacroMenuRecordToggleClick" />
              <Separator />
              <MenuItem Header="已保存的宏"
                        IsEnabled="{Binding HasMacros}"
                        Click="OnMacroMenuSavedClick" />
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="宏"
                     FontSize="12"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>

        <Button Grid.Column="6"
                Classes="TitleBarButton WindowMinButton"
                ToolTip.Tip="Minimize"
                Click="OnMinimizeClick">
          <TextBlock Text="&#xF1639;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="7"
                Name="MaximizeButton"
                Classes="TitleBarButton WindowMaxButton"
                ToolTip.Tip="Maximize"
                Click="OnMaximizeClick">
          <TextBlock Name="MaximizeIcon"
                     Text="&#xF05AF;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="8"
                Classes="TitleBarButton WindowCloseButton"
                ToolTip.Tip="Close"
                Click="OnCloseClick">
          <TextBlock Text="&#xF05AD;"
                     FontFamily="{DynamicResource IconMaterialDesign}"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- Left margin is 0 so the sidebar (and its icon rail) sits flush on the
         window edge, MobaXterm-style. The content column carries the 32px left
         inset itself, keeping the terminal and tab strip in the same absolute
         position as before (E2E coordinates unchanged). -->
    <Grid Grid.Row="1"
          Name="BodyGrid"
          Margin="0,0,10,10"
          ColumnDefinitions="260,3,*">
      <views:SessionSidebar Grid.Column="0"
                            Name="Sidebar" />

      <GridSplitter Grid.Column="1"
                    Name="SidebarSplitter"
                    Width="3"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    DragCompleted="OnSidebarSplitterDragCompleted" />

      <Grid Grid.Column="2" Name="ContentArea" Margin="32,0,0,0">
        <Grid Name="MainStack">
          <!-- Empty state mirrors main2.py: one part above, two parts below. -->
          <Grid Name="EmptyState"
                RowDefinitions="*,20,6,20,6,32,2*"
                IsVisible="{Binding !HasTabs}"
                Margin="0,3,0,0">
            <TextBlock Grid.Row="1"
                       Classes="EmptyTitle"
                       Text="Select a session from the left"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="3"
                       Name="EmptyStateAddHint"
                       Classes="EmptyTitle"
                       Text="or click + to add a session"
                       VerticalAlignment="Center" />
            <Button Grid.Row="5"
                    Name="EmptyAddSessionButton"
                    Classes="EmptyAddButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip.Tip="New session">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf1e6;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#43a047"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf233;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#1976d2"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf120;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#00897b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf0ac;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#f57c00"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionClick">
                    <MenuItem.Icon>
                      <TextBlock Text="&#xf108;"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Foreground="#607d8b"
                                 VerticalAlignment="Center" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
              <TextBlock Text="&#xf067;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="14"
                         Foreground="White" />
            </Button>
          </Grid>

          <Grid Name="TabHost"
                IsVisible="{Binding HasTabs}"
                RowDefinitions="36,*">
            <Grid Grid.Row="0" Height="36" ColumnDefinitions="*,Auto">
              <ItemsControl Grid.Column="0"
                            ItemsSource="{Binding Tabs}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TerminalTab">
                    <Border Classes="TabItemBorder"
                            Classes.selected="{Binding IsSelected}"
                            Focusable="False"
                            PointerPressed="OnTabPointerPressed"
                            DoubleTapped="OnTabDoubleTapped"
                            ToolTip.Tip="Double click to detach as a window"
                            Tag="{Binding}">
                      <StackPanel Orientation="Horizontal"
                                  VerticalAlignment="Center"
                                  Spacing="8">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding TabDotBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Classes="TabTitle"
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center" />
                        <Button Classes="TabCloseButton"
                                Width="16" Height="16"
                                MinWidth="0" MinHeight="0"
                                Padding="0"
                                Tag="{Binding}"
                                Click="OnCloseTabClick">
                          <Image Source="/Assets/close.png"
                                 Width="10" Height="10" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="0"
                          Margin="0,3,0,0"
                          VerticalAlignment="Top">
                <ComboBox Name="EncodingCombo"
                          Classes="EncodingCombo"
                          Width="97" Height="31"
                          MinWidth="60"
                          VerticalAlignment="Top"
                          SelectionChanged="OnEncodingChanged"
                          DropDownClosed="OnEncodingDropDownClosed">
                  <ComboBoxItem Content="ASCII" />
                  <ComboBoxItem Content="UTF-8" />
                  <ComboBoxItem Content="UTF-16" />
                  <ComboBoxItem Content="GBK" />
                  <ComboBoxItem Content="GB2312" />
                  <ComboBoxItem Content="GB18030" />
                </ComboBox>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*,6,30">
              <Border Grid.Row="0"
                      Name="MacroStatusBanner"
                      Height="26"
                      Background="#fff3f3"
                      BorderBrush="#e03131"
                      BorderThickness="0,1,0,0"
                      IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Name="MacroBannerText"
                             FontSize="11"
                             Foreground="#c92a2a"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1"
                          Name="MacroBannerActionButton"
                          Content="停止"
                          Width="64" Height="20"
                          MinWidth="0" MinHeight="0"
                          Margin="8,0,8,0"
                          Click="OnMacroBannerActionClick" />
                </Grid>
              </Border>
              <Border Grid.Row="1"
                      Background="White"
                      BorderBrush="{DynamicResource SidebarBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="3"
                      Padding="9">
                <ContentControl Name="TabContentHost"
                                Content="{Binding SelectedTab.Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
              </Border>
              <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedTab.StatusMessage}"
                           FontSize="12"
                           Foreground="{Binding SelectedTab.StatusBrush}"
                           Margin="4,0,4,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            IsVisible="{Binding SelectedTab.ShowStatusProgress}">
                  <TextBlock Text="{Binding SelectedTab.StatusProgressLabel}"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <ProgressBar Width="150"
                               Height="14"
                               MinWidth="0"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding SelectedTab.ZmodemProgress}"
                               IsIndeterminate="{Binding SelectedTab.StatusProgressIndeterminate}"
                               ShowProgressText="{Binding SelectedTab.ShowProgressTextVisible}"
                               VerticalAlignment="Center" />
                  <Button Content="Cancel"
                          Width="90"
                          Height="24"
                          MinHeight="0"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          IsEnabled="{Binding SelectedTab.IsZmodemCancellable}"
                          IsVisible="{Binding SelectedTab.IsZmodemActive}"
                          Click="OnZmodemCancelClick" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>

        <!-- Ctrl+Space popup: the saved-macros list floating over the content area -->
        <Border Name="MacroPopup"
                IsVisible="False"
                Width="300"
                Background="#f5f5f5"
                BorderBrush="#9aa0a6"
                BorderThickness="1"
                CornerRadius="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ZIndex="100">
          <ItemsControl Name="MacroPopupList" ItemsSource="{Binding Macros}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MacroItem">
                <Button Name="MacroPopupRow"
                        Classes="MacroPopupRow"
                        Tag="{Binding}"
                        Click="OnMacroPopupRowClick">
                  <Grid ColumnDefinitions="*,Auto" Margin="8,5">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Hotkey}"
                               FontSize="11"
                               Foreground="#9e9e9e"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Hotkey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
