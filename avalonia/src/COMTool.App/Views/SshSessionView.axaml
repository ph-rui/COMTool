<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="COMTool.App.Views.SshSessionView">
  <!-- The SFTP browser lives in the left sidebar, so the tab of an SSH
       session holds only the terminal. -->
  <ContentControl Name="TerminalHost" />
</UserControl>
