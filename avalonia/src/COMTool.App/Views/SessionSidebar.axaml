<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COMTool.App.ViewModels"
             x:Class="COMTool.App.Views.SessionSidebar"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="28,5,*" Margin="0,5,0,0">
    <!-- Header mirrors session_sidebar.py: star + user + "User sessions". -->
    <Grid Grid.Row="0" Margin="10,2,8,2" ColumnDefinitions="Auto,6,Auto,6,*,6,Auto">
      <TextBlock Grid.Column="0"
                 Text="&#xf005;"
                 FontFamily="{DynamicResource IconFontAwesome}"
                 FontSize="15"
                 Foreground="#f2b01e"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="2"
                 Text="&#xf007;"
                 FontFamily="{DynamicResource IconFontAwesome}"
                 FontSize="15"
                 Foreground="#5b8fd6"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="4"
                 Classes="SidebarTitle"
                 Text="User sessions" />
      <Button Grid.Column="6"
              Name="SidebarAddSessionButton"
              Classes="SidebarAddButton"
              ToolTip.Tip="New session">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionMenuItemClick">
              <MenuItem.Icon>
                <TextBlock Text="&#xf1e6;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="14"
                           Foreground="#43a047"
                           VerticalAlignment="Center" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionMenuItemClick">
              <MenuItem.Icon>
                <TextBlock Text="&#xf233;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="14"
                           Foreground="#1976d2"
                           VerticalAlignment="Center" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionMenuItemClick">
              <MenuItem.Icon>
                <TextBlock Text="&#xf120;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="14"
                           Foreground="#00897b"
                           VerticalAlignment="Center" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionMenuItemClick">
              <MenuItem.Icon>
                <TextBlock Text="&#xf0ac;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="14"
                           Foreground="#f57c00"
                           VerticalAlignment="Center" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionMenuItemClick">
              <MenuItem.Icon>
                <TextBlock Text="&#xf108;"
                           FontFamily="{DynamicResource IconFontAwesome}"
                           FontSize="14"
                           Foreground="#607d8b"
                           VerticalAlignment="Center" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
        <TextBlock Text="&#xf067;"
                   FontFamily="{DynamicResource IconFontAwesome}"
                   FontSize="13"
                   Foreground="White" />
      </Button>
    </Grid>

    <Grid Grid.Row="2" Margin="16,0,0,0">
      <Border Name="SessionListFrame"
              Background="{DynamicResource SidebarListBackgroundBrush}"
              BorderBrush="{DynamicResource SidebarBorderBrush}"
              BorderThickness="1"
              CornerRadius="3"
              Padding="2">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarSection">
                  <StackPanel>
                    <TextBlock Classes="SectionHeader"
                               Text="{Binding Title}"
                               IsVisible="{Binding ShowHeader}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItem">
                          <Grid MinHeight="40"
                                ColumnDefinitions="16,*,Auto"
                                Background="Transparent"
                                Cursor="Hand"
                                Tapped="OnSessionTapped">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding IconGlyph}"
                                       FontFamily="{DynamicResource IconFontAwesome}"
                                       FontSize="14"
                                       Foreground="{Binding IconBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <StackPanel Grid.Column="1"
                                        Margin="6,3,4,3"
                                        VerticalAlignment="Center"
                                        Spacing="0">
                              <TextBlock Classes="SessionName" Text="{Binding Name}" />
                              <TextBlock Classes="SessionDetail"
                                         Text="{Binding Detail}"
                                         IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              <TextBlock Classes="SessionDetail"
                                         Text="{Binding SerialSettings}"
                                         IsVisible="{Binding SerialSettings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Text="No saved sessions"
                     FontSize="12"
                     Foreground="{DynamicResource WindowTextBrush}"
                     Margin="4,8,4,0"
                     VerticalAlignment="Top"
                     IsVisible="{Binding !HasSessions}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
