<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COMTool.App.ViewModels"
             xmlns:views="using:COMTool.App.Views"
             xmlns:sys="using:System"
             x:Class="COMTool.App.Views.SessionSidebar"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="40,*" Margin="0,5,0,0">
    <!-- MobaXterm-style icon rail: Sessions / Tools / Macros, plus the
         SSH-browser icon that only exists while an SSH session is connected. -->
    <Border Grid.Column="0"
            Name="SidebarRail"
            Background="{DynamicResource SidebarRailBackgroundBrush}"
            CornerRadius="0">
      <StackPanel>
        <Button Name="RailSessionsButton"
                Classes="RailButton"
                Classes.active="{Binding RailSessionsActive}"
                Tag="Sessions"
                Click="OnRailTabClick"
                ToolTip.Tip="会话（保存的会话列表）">
          <TextBlock Text="&#xf005;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#f2b01e" />
        </Button>
        <Button Name="RailToolsButton"
                Classes="RailButton"
                Classes.active="{Binding RailToolsActive}"
                Tag="Tools"
                Click="OnRailTabClick"
                ToolTip.Tip="工具（网络服务器/扫描仪）">
          <TextBlock Text="&#xf7d9;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#e8734a" />
        </Button>
        <Button Name="RailMacrosButton"
                Classes="RailButton"
                Classes.active="{Binding RailMacrosActive}"
                Tag="Macros"
                Click="OnRailTabClick"
                ToolTip.Tip="宏（命令一键发送）">
          <TextBlock Text="&#xf1d8;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#2f7ed8" />
        </Button>
        <!-- MobaXterm shows this globe only while the selected tab is a live SSH login. -->
        <Button Name="RailSshBrowserButton"
                Classes="RailButton"
                Classes.active="{Binding RailSshBrowserActive}"
                IsVisible="{Binding IsSshBrowserVisible}"
                Click="OnRailSshBrowserClick"
                ToolTip.Tip="SSH 浏览器（SFTP）">
          <TextBlock Text="&#xf57d;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#ff9800" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Panel content: a header plus exactly one visible body per tab.
         ClipToBounds keeps the panel out of the terminal while the dock
         is collapsed to the 40px rail (its star column becomes zero). -->
    <Grid Grid.Column="1"
          RowDefinitions="28,5,*"
          ClipToBounds="True">
      <Grid Grid.Row="0" Margin="8,2,6,2" ColumnDefinitions="Auto,6,*,6,Auto">
        <TextBlock Grid.Column="0"
                   Text="&#xf007;"
                   FontFamily="{DynamicResource IconFontAwesome}"
                   FontSize="15"
                   Foreground="#5b8fd6"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsSessionsTab}" />
        <TextBlock Grid.Column="2"
                   Classes="SidebarTitle"
                   Text="{Binding SidebarTitle}"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="4"
                Name="SidebarAddSessionButton"
                Classes="SidebarAddButton"
                IsVisible="{Binding IsSessionsTab}"
                ToolTip.Tip="New session">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf1e6;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#43a047"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf084;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#f0b429"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf120;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#00897b"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf0ac;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#f57c00"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf108;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#607d8b"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="&#xf067;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="13"
                     Foreground="White" />
        </Button>
      </Grid>

      <!-- Sessions -->
      <Grid Grid.Row="2" Name="SessionsPanel" Margin="4,0,2,0" IsVisible="{Binding IsSessionsTab}">
        <Border Name="SessionListFrame"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarSection">
                    <StackPanel>
                      <TextBlock Classes="SectionHeader"
                                 Text="{Binding Title}"
                                 IsVisible="{Binding ShowHeader}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SessionItem">
                            <!-- MobaXterm-style compact row: line 1 = name (detail),
                                 line 2 = serial params. -->
                            <Grid MinHeight="28"
                                  ColumnDefinitions="16,*,Auto"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  Tapped="OnSessionTapped">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding IconGlyph}"
                                         FontFamily="{DynamicResource IconFontAwesome}"
                                         FontSize="13"
                                         Foreground="{Binding IconBrush}"
                                         VerticalAlignment="Center"
                                         Margin="6,0,0,0" />
                              <StackPanel Grid.Column="1"
                                          Margin="6,1,4,1"
                                          VerticalAlignment="Center"
                                          Spacing="0">
                                <TextBlock Classes="SessionName"
                                           Text="{Binding RowTitle}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="SessionDetail"
                                           Text="{Binding SerialSettings}"
                                           IsVisible="{Binding SerialSettings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                              <TextBlock Grid.Column="2"
                                         Classes="SessionConnecting"
                                         Text="Connecting..."
                                         IsVisible="{Binding IsConnecting}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No saved sessions"
                       FontSize="12"
                       Foreground="{DynamicResource WindowTextBrush}"
                       Margin="4,8,4,0"
                       VerticalAlignment="Top"
                       IsVisible="{Binding !HasSessions}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Tools: the standalone tool windows from ToolCatalog -->
      <Grid Grid.Row="2" Name="ToolsPanel" Margin="4,0,2,0" IsVisible="{Binding IsToolsTab}">
        <Border Name="ToolsMenuView"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <ScrollViewer Name="ToolMenuScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ToolMenu}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolMenuItem">
                  <Button Classes="ToolMenuItemButton"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip.Tip="{Binding ToolTip}"
                          Tag="{Binding Id}"
                          Click="OnToolMenuClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding Glyph}"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="14"
                                 Width="18"
                                 TextAlignment="Center"
                                 Foreground="{Binding GlyphColor}" />
                      <TextBlock Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Macros (MobaXterm 22.1 style: record button + saved list + context menu) -->
      <Grid Grid.Row="2" Name="MacrosPanel" RowDefinitions="Auto,Auto,*" Margin="4,0,2,0" IsVisible="{Binding IsMacrosTab}">
        <Button Grid.Row="0"
                Name="MacroRecordButton"
                Classes="MacroRecordButton"
                IsEnabled="{Binding CanToggleRecording}"
                Click="OnMacroRecordToggleClick"
                ToolTip.Tip="录制新宏 / 停止录制">
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Grid Width="14" Height="14" VerticalAlignment="Center">
              <!-- MobaXterm 风格：灰环 + 红点（空闲常显）；录制中仅红点放大 -->
              <TextBlock Text="&#xf05c;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="13"
                         Foreground="#8a8a8a"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !IsRecording}" />
              <TextBlock Text="&#xf111;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="6"
                         Foreground="#e03131"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !IsRecording}" />
              <TextBlock Name="MacroRecordDot"
                         Text="&#xf111;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="11"
                         Foreground="#e03131"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsRecording}" />
            </Grid>
            <TextBlock Name="MacroRecordText"
                       Text="{Binding RecordButtonText}"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border Grid.Row="1"
                Margin="0,4,0,4"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="6,4">
          <Grid>
            <TextBlock Name="SavedMacrosHeader"
                       Text="已保存的宏"
                       FontSize="11"
                       Foreground="#3c4043"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasMacros}" />
            <TextBlock Name="SavedMacrosHeaderEmpty"
                       Text="已保存的宏"
                       FontSize="11"
                       Foreground="#9e9e9e"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !HasMacros}" />
          </Grid>
        </Border>
        <Border Grid.Row="2"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="MacroList" ItemsSource="{Binding Macros}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MacroItem">
                  <Border Name="MacroRowBorder"
                          Classes="MacroRow"
                          Margin="2,1"
                          Padding="4,3"
                          Cursor="Hand"
                          Tapped="OnMacroRowTapped">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding MenuRenameHeader}" Click="OnMacroRenameClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf044;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#e8a33d" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuEditHeader}" Click="OnMacroEditClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf044;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#5f6368" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuDuplicateHeader}" Click="OnMacroDuplicateClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf24d;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#5f6368" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuDeleteHeader}" Click="OnMacroDeleteClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf1f8;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#d13438" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{Binding MenuHotkeyHeader}" Click="OnMacroHotkeyClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf11b;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#5f6368" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding MenuExecuteHeader}" Click="OnMacroExecuteClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf144;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#2f7ed8" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="创建桌面快捷方式(W)"
                                  IsEnabled="False"
                                  ToolTip.Tip="暂不支持（框架已预留）">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf005;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#e8a33d" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="导入宏(Y)" Click="OnMacroImportClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf305;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#d13438" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="导出宏(Z)" Click="OnMacroExportClick">
                          <MenuItem.Icon>
                            <TextBlock Text="&#xf306;" FontFamily="{DynamicResource IconFontAwesome}" FontSize="11" Foreground="#2f7ed8" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <!-- MobaXterm 行图标：灰环 + 蓝色播放三角（RDP 实机核对 2026-10-28）。
                           圆环用矢量 Border 绘制（FA6 solid 无空心圆字形，f10c 是实心盘） -->
                      <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="6"
                                BorderBrush="#6e6e6e" BorderThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="&#xf04b;"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="6"
                                   Foreground="#2196f3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Classes="SessionName"
                                 Text="{Binding Name}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Hotkey}"
                                 FontSize="10"
                                 Foreground="#9e9e9e"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding Hotkey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- The SSH browser covers the whole panel, header included, while the
         rail keeps its place. -->
    <views:SshBrowserPanel Grid.Column="1"
                           Name="SshBrowserPanel"
                           IsVisible="{Binding IsSshBrowserTab}"
                           Pane="{Binding SshBrowserPane}" />
  </Grid>
</UserControl>
