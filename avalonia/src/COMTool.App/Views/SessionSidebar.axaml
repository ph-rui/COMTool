<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COMTool.App.ViewModels"
             xmlns:sys="using:System"
             x:Class="COMTool.App.Views.SessionSidebar"
             x:DataType="vm:MainViewModel">
  <Grid ColumnDefinitions="24,*" Margin="0,5,0,0">
    <!-- MobaXterm-style icon rail: Sessions / Tools / Macros / History. -->
    <Border Grid.Column="0"
            Name="SidebarRail"
            Background="{DynamicResource SidebarRailBackgroundBrush}"
            CornerRadius="3,0,0,3">
      <StackPanel>
        <Button Name="RailSessionsButton"
                Classes="RailButton"
                Classes.active="{Binding IsSessionsTab}"
                Tag="Sessions"
                Click="OnRailTabClick"
                ToolTip.Tip="会话（保存的会话列表）">
          <TextBlock Text="&#xf005;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#f2b01e" />
        </Button>
        <Button Name="RailToolsButton"
                Classes="RailButton"
                Classes.active="{Binding IsToolsTab}"
                Tag="Tools"
                Click="OnRailTabClick"
                ToolTip.Tip="工具（网络扫描仪）">
          <TextBlock Text="&#xf0c4;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#d9534f" />
        </Button>
        <Button Name="RailMacrosButton"
                Classes="RailButton"
                Classes.active="{Binding IsMacrosTab}"
                Tag="Macros"
                Click="OnRailTabClick"
                ToolTip.Tip="宏（命令一键发送）">
          <TextBlock Text="&#xf1d8;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#2f7ed8" />
        </Button>
        <Button Name="RailHistoryButton"
                Classes="RailButton"
                Classes.active="{Binding IsHistoryTab}"
                Tag="History"
                Click="OnRailTabClick"
                ToolTip.Tip="历史（最近打开的会话）">
          <TextBlock Text="&#xf1da;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="16"
                     Foreground="#e0a526" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Panel content: a header plus exactly one visible body per tab. -->
    <Grid Grid.Column="1" RowDefinitions="28,5,*">
      <Grid Grid.Row="0" Margin="8,2,6,2" ColumnDefinitions="Auto,6,*,6,Auto">
        <Button Grid.Column="0"
                Name="SidebarBackToolsButton"
                Classes="SidebarTextButton"
                Content="← 返回"
                FontSize="11"
                IsVisible="{Binding IsToolsSubView}"
                Click="OnToolCloseClick"
                ToolTip.Tip="返回工具列表" />
        <TextBlock Grid.Column="0"
                   Text="&#xf007;"
                   FontFamily="{DynamicResource IconFontAwesome}"
                   FontSize="15"
                   Foreground="#5b8fd6"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsSessionsTab}" />
        <TextBlock Grid.Column="2"
                   Classes="SidebarTitle"
                   Text="{Binding SidebarTitle}"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="4"
                Name="SidebarAddSessionButton"
                Classes="SidebarAddButton"
                IsVisible="{Binding IsSessionsTab}"
                ToolTip.Tip="New session">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Serial" Tag="Serial" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf1e6;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#43a047"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="SSH" Tag="SSH" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf233;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#1976d2"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Telnet" Tag="Telnet" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf120;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#00897b"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="TCP" Tag="TCP" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf0ac;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#f57c00"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Local terminal" Tag="Local" Click="OnNewSessionMenuItemClick">
                <MenuItem.Icon>
                  <TextBlock Text="&#xf108;"
                             FontFamily="{DynamicResource IconFontAwesome}"
                             FontSize="14"
                             Foreground="#607d8b"
                             VerticalAlignment="Center" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="&#xf067;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="13"
                     Foreground="White" />
        </Button>
        <Button Grid.Column="4"
                Name="SidebarAddMacroButton"
                Classes="SidebarAddButton"
                IsVisible="{Binding IsMacrosTab}"
                Click="OnAddMacroClick"
                ToolTip.Tip="新建宏">
          <TextBlock Text="&#xf067;"
                     FontFamily="{DynamicResource IconFontAwesome}"
                     FontSize="13"
                     Foreground="White" />
        </Button>
        <Button Grid.Column="4"
                Name="SidebarClearHistoryButton"
                Classes="SidebarTextButton"
                IsVisible="{Binding IsHistoryTab}"
                Click="OnClearHistoryClick"
                ToolTip.Tip="清空历史">
          <TextBlock Text="清空" FontSize="11" />
        </Button>
      </Grid>

      <!-- Sessions -->
      <Grid Grid.Row="2" Name="SessionsPanel" Margin="4,0,2,0" IsVisible="{Binding IsSessionsTab}">
        <Border Name="SessionListFrame"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarSection">
                    <StackPanel>
                      <TextBlock Classes="SectionHeader"
                                 Text="{Binding Title}"
                                 IsVisible="{Binding ShowHeader}" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SessionItem">
                            <!-- MobaXterm-style compact row: line 1 = name (detail),
                                 line 2 = serial params. -->
                            <Grid MinHeight="28"
                                  ColumnDefinitions="16,*,Auto"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  Tapped="OnSessionTapped">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding IconGlyph}"
                                         FontFamily="{DynamicResource IconFontAwesome}"
                                         FontSize="13"
                                         Foreground="{Binding IconBrush}"
                                         VerticalAlignment="Center"
                                         Margin="6,0,0,0" />
                              <StackPanel Grid.Column="1"
                                          Margin="6,1,4,1"
                                          VerticalAlignment="Center"
                                          Spacing="0">
                                <TextBlock Classes="SessionName"
                                           Text="{Binding RowTitle}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="SessionDetail"
                                           Text="{Binding SerialSettings}"
                                           IsVisible="{Binding SerialSettings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                              <TextBlock Grid.Column="2"
                                         Classes="SessionConnecting"
                                         Text="Connecting..."
                                         IsVisible="{Binding IsConnecting}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No saved sessions"
                       FontSize="12"
                       Foreground="{DynamicResource WindowTextBrush}"
                       Margin="4,8,4,0"
                       VerticalAlignment="Top"
                       IsVisible="{Binding !HasSessions}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Tools: MobaXterm-style tool menu + network scanner dialog -->
      <Grid Grid.Row="2" Name="ToolsPanel" Margin="4,0,2,0" IsVisible="{Binding IsToolsTab}">
        <!-- Tool menu (mirrors MobaXterm's "Tools" dropdown) -->
        <Border Name="ToolsMenuView"
                IsVisible="{Binding IsToolsMenu}"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <ScrollViewer Name="ToolMenuScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ToolMenu}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolMenuItem">
                  <Grid>
                    <!-- 分组标题行（系统/文本/网络，1:1 MobaXterm 分组条） -->
                    <Border IsVisible="{Binding IsHeader}"
                            Background="{DynamicResource SidebarGroupHeaderBrush}"
                            CornerRadius="2"
                            Margin="2,6,2,2"
                            Padding="6,3">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SidebarSectionBrush}" />
                    </Border>
                    <!-- 工具项：彩色图标 + 名称（1:1 MobaXterm 图标菜单） -->
                    <Button IsVisible="{Binding !IsHeader}"
                            Classes="ToolMenuItemButton"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip.Tip="{Binding ToolTip}"
                            Tag="{Binding Id}"
                            Click="OnToolMenuClick">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="11"
                                   Width="16"
                                   TextAlignment="Center"
                                   Foreground="{Binding GlyphColor}" />
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- 网络扫描仪 (1:1 MobaXterm "网络扫描": IP 地址范围 octet 输入 + 固定服务列 + Start scan) -->
        <Grid Name="NetworkScannerView"
              IsVisible="{Binding IsNetworkScannerView}"
              RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="SidebarCard"
                  Margin="0,0,0,4">
            <StackPanel Spacing="4">
              <TextBlock Classes="SidebarFieldLabel" Text="IP 地址范围" />
              <!-- 窄侧栏适配：5 段框 + 点 + 箭头总计 ~154px，卡片内容区 ~158px -->
              <StackPanel Orientation="Horizontal"
                          Spacing="1"
                          VerticalAlignment="Center">
                <TextBox Name="ScanOctet1Box"
                         Text="{Binding ScanOctet1}"
                         FontSize="10"
                         Width="24"
                         HorizontalContentAlignment="Center" />
                <TextBlock Text="."
                           FontSize="10"
                           VerticalAlignment="Center" />
                <TextBox Name="ScanOctet2Box"
                         Text="{Binding ScanOctet2}"
                         FontSize="10"
                         Width="24"
                         HorizontalContentAlignment="Center" />
                <TextBlock Text="."
                           FontSize="10"
                           VerticalAlignment="Center" />
                <TextBox Name="ScanOctet3Box"
                         Text="{Binding ScanOctet3}"
                         FontSize="10"
                         Width="24"
                         HorizontalContentAlignment="Center" />
                <TextBlock Text="."
                           FontSize="10"
                           VerticalAlignment="Center" />
                <TextBox Name="ScanOctetFromBox"
                         Text="{Binding ScanOctetFrom}"
                         FontSize="10"
                         Width="24"
                         HorizontalContentAlignment="Center" />
                <TextBlock Text="--&gt;"
                           FontSize="10"
                           VerticalAlignment="Center" />
                <TextBox Name="ScanOctetToBox"
                         Text="{Binding ScanOctetTo}"
                         FontSize="10"
                         Width="24"
                         HorizontalContentAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          Spacing="6"
                          Margin="0,2,0,0">
                <Button Name="ScanStartButton"
                        Classes="SidebarActionButton"
                        IsEnabled="{Binding !IsBusy}"
                        Click="OnNetScanStartClick"
                        ToolTip.Tip="Start scan">
                  <StackPanel Orientation="Horizontal"
                              Spacing="4"
                              HorizontalAlignment="Center">
                    <TextBlock Text="&#xf04b;"
                               FontFamily="{DynamicResource IconFontAwesome}"
                               FontSize="10"
                               Foreground="White" />
                    <TextBlock Text="Start scan" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="SidebarError"
                         Text="{Binding ScanError}"
                         IsVisible="{Binding ScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1"
                  Background="{DynamicResource SidebarListBackgroundBrush}"
                  BorderBrush="{DynamicResource SidebarBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="2">
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Classes="SidebarDetail"
                             Text="{Binding ScanStatus}"
                             Margin="4,4,4,0"
                             IsVisible="{Binding ScanStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <!-- 列头 1:1 MobaXterm: IP 地址 | 名称 | SSH | RDP | VNC | FTP | Telnet | Rlogin | HTTP | 其他端口 -->
                  <StackPanel Orientation="Horizontal"
                              Margin="4,4,4,2">
                    <TextBlock Text="IP 地址"
                               Width="88"
                               FontSize="9"
                               Foreground="{DynamicResource SidebarSectionBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="名称"
                               Width="36"
                               FontSize="9"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="SSH"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="RDP"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="VNC"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="FTP"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="Telnet"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Rlogin"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="HTTP"
                               Width="28"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionBrush}" />
                    <TextBlock Text="其他端口"
                               Width="52"
                               FontSize="9"
                               Foreground="{DynamicResource SidebarSectionBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding ScanRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ScanGridRow">
                        <StackPanel Orientation="Horizontal"
                                    Margin="4,2,4,0">
                          <TextBlock Text="{Binding Address}"
                                     Width="88"
                                     FontSize="10"
                                     Classes="SessionName"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding HostName}"
                                     Width="36"
                                     FontSize="9"
                                     Classes="SidebarDetail"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding HostName}" />
                          <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PortCell">
                                <TextBlock Text="{Binding Glyph}"
                                           Width="28"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource IconFontAwesome}"
                                           Foreground="{Binding Foreground}"
                                           ToolTip.Tip="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding OtherPorts}"
                                     Width="52"
                                     FontSize="9"
                                     Classes="SidebarDetail"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding OtherPorts}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="点击 Start scan 开始扫描"
                         FontSize="12"
                         Foreground="{DynamicResource WindowTextBrush}"
                         Margin="4,8,4,0"
                         VerticalAlignment="Top"
                         IsVisible="{Binding !HasScanRows}" />
            </Grid>
          </Border>

          <Button Grid.Row="2"
                  Name="NetScanCloseButton"
                  Classes="SidebarActionButton"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Center"
                  Click="OnToolCloseClick">
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center">
              <TextBlock Text="&#xf00d;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="10"
                         Foreground="White" />
              <TextBlock Text="关闭" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- 端口扫描仪 (1:1 MobaXterm "端口扫描仪": IP 地址 + 已知端口/端口范围 + Start scan) -->
        <Grid Name="PortScannerView"
              IsVisible="{Binding IsPortScannerView}"
              RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0"
                  Classes="SidebarCard"
                  Margin="0,0,0,4">
            <StackPanel Spacing="4">
              <TextBlock Classes="SidebarFieldLabel" Text="IP 地址" />
              <TextBox Name="PortScanIpBox"
                       Text="{Binding PortScanIp}"
                       PlaceholderText="192.168.1.100"
                       FontSize="11" />
              <RadioButton Name="PortScanKnownRadio"
                           GroupName="PortScanMode"
                           IsChecked="True"
                           Content="仅扫描已知端口"
                           FontSize="11"
                           Margin="0,2,0,0" />
              <RadioButton Name="PortScanRangeRadio"
                           GroupName="PortScanMode"
                           IsChecked="{Binding PortScanRangeMode, Mode=TwoWay}"
                           Content="扫描端口范围"
                           FontSize="11" />
              <!-- 范围框单列一行（窄侧栏放不下与单选同行）；IsEnabled 必须绑在输入框自身 -->
              <StackPanel Orientation="Horizontal"
                          Spacing="4"
                          VerticalAlignment="Center">
                <TextBox Name="PortScanFromBox"
                         Text="{Binding PortScanFrom}"
                         FontSize="11"
                         Width="46"
                         HorizontalContentAlignment="Center"
                         IsEnabled="{Binding PortScanRangeMode}" />
                <TextBlock Text="--&gt;"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <TextBox Name="PortScanToBox"
                         Text="{Binding PortScanTo}"
                         FontSize="11"
                         Width="54"
                         HorizontalContentAlignment="Center"
                         IsEnabled="{Binding PortScanRangeMode}" />
              </StackPanel>
              <!-- 竖排：两按钮横排(~182px)超出卡片内容区(~158px)，停止按钮会被挤出可点区域 -->
              <StackPanel Spacing="4"
                          Margin="0,2,0,0">
                <Button Name="PortScanStartButton"
                        Classes="SidebarActionButton"
                        IsEnabled="{Binding !IsBusy}"
                        Click="OnPortScanStartClick"
                        ToolTip.Tip="Start scan">
                  <StackPanel Orientation="Horizontal"
                              Spacing="4"
                              HorizontalAlignment="Center">
                    <TextBlock Text="&#xf04b;"
                               FontFamily="{DynamicResource IconFontAwesome}"
                               FontSize="10"
                               Foreground="White" />
                    <TextBlock Text="Start scan" />
                  </StackPanel>
                </Button>
                <Button Name="PortScanStopButton"
                        Classes="SidebarActionButton"
                        Content="停止"
                        IsEnabled="{Binding IsPortScanning}"
                        Click="OnPortScanStopClick" />
              </StackPanel>
              <TextBlock Classes="SidebarError"
                         Text="{Binding PortScanError}"
                         IsVisible="{Binding PortScanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="SidebarDetail"
                         Text="{Binding PortScanStatus}"
                         IsVisible="{Binding PortScanStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1"
                  Background="{DynamicResource SidebarListBackgroundBrush}"
                  BorderBrush="{DynamicResource SidebarBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="2">
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding PortScanResult}"
                           FontSize="10"
                           TextWrapping="NoWrap"
                           Margin="6,4" />
              </ScrollViewer>
              <TextBlock Text="点击 Start scan 开始扫描"
                         FontSize="12"
                         Foreground="{DynamicResource WindowTextBrush}"
                         Margin="4,8,4,0"
                         VerticalAlignment="Top"
                         IsVisible="{Binding !HasPortScanResult}" />
            </Grid>
          </Border>

          <Button Grid.Row="2"
                  Name="PortScanCloseButton"
                  Classes="SidebarActionButton"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Center"
                  Click="OnToolCloseClick">
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center">
              <TextBlock Text="&#xf00d;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="10"
                         Foreground="White" />
              <TextBlock Text="关闭" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <!-- Macros -->
      <Grid Grid.Row="2" Name="MacrosPanel" RowDefinitions="Auto,*" Margin="4,0,2,0" IsVisible="{Binding IsMacrosTab}">
        <Border Grid.Row="0"
                Classes="SidebarCard"
                Margin="0,0,0,4"
                IsVisible="{Binding IsMacroEditorOpen}">
          <StackPanel Spacing="4">
            <TextBlock Classes="SidebarFieldLabel" Text="宏名称" />
            <TextBox Name="MacroNameBox"
                     Text="{Binding MacroEditorName}"
                     PlaceholderText="例如：重启"
                     FontSize="11" />
            <TextBlock Classes="SidebarFieldLabel" Text="命令" />
            <TextBox Name="MacroTextBox"
                     Text="{Binding MacroEditorText}"
                     PlaceholderText="要发送的命令"
                     FontSize="11"
                     AcceptsReturn="True"
                     Height="48" />
            <CheckBox Content="发送后回车"
                      IsChecked="{Binding MacroEditorAppendEnter}"
                      FontSize="11" />
            <TextBlock Classes="SidebarError"
                       Text="{Binding MacroEditorError}"
                       IsVisible="{Binding MacroEditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        Margin="0,2,0,0">
              <Button Name="MacroSaveButton"
                      Classes="SidebarActionButton"
                      Content="保存"
                      Click="OnMacroSaveClick" />
              <Button Name="MacroCancelButton"
                      Classes="SidebarActionButton"
                      Content="取消"
                      Click="OnMacroCancelClick" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1"
                Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Macros}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MacroItem">
                    <Grid Margin="4,2,2,2"
                          ColumnDefinitions="*,Auto,Auto,Auto"
                          Background="Transparent">
                      <StackPanel Grid.Column="0"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"
                                  Spacing="0">
                        <TextBlock Classes="SessionName"
                                   Text="{Binding Name}"
                                   FontSize="11" />
                        <TextBlock Classes="SessionDetail"
                                   Text="{Binding Text}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="SidebarIconButton"
                              ToolTip.Tip="发送到当前终端"
                              IsEnabled="{Binding $parent[UserControl].DataContext.CanSendMacro}"
                              Click="OnMacroSendClick">
                        <TextBlock Text="&#xf1d8;"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="12"
                                   Foreground="#2f7ed8" />
                      </Button>
                      <Button Grid.Column="2"
                              Classes="SidebarIconButton"
                              ToolTip.Tip="编辑"
                              Click="OnMacroEditClick">
                        <TextBlock Text="&#xf044;"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="12"
                                   Foreground="#607d8b" />
                      </Button>
                      <Button Grid.Column="3"
                              Classes="SidebarIconButton"
                              ToolTip.Tip="删除"
                              Click="OnMacroDeleteClick">
                        <TextBlock Text="&#xf1f8;"
                                   FontFamily="{DynamicResource IconFontAwesome}"
                                   FontSize="12"
                                   Foreground="#c62828" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="暂无宏"
                       FontSize="12"
                       Foreground="{DynamicResource WindowTextBrush}"
                       Margin="4,8,4,0"
                       VerticalAlignment="Top"
                       IsVisible="{Binding !HasMacros}" />
          </Grid>
        </Border>
      </Grid>

      <!-- History -->
      <Grid Grid.Row="2" Name="HistoryPanel" Margin="4,0,2,0" IsVisible="{Binding IsHistoryTab}">
        <Border Background="{DynamicResource SidebarListBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="2">
          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntry">
                    <Grid Margin="4,2,2,2"
                          MinHeight="30"
                          ColumnDefinitions="16,*,Auto"
                          Background="Transparent"
                          Cursor="Hand"
                          Tapped="OnHistoryTapped">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding IconGlyph}"
                                 FontFamily="{DynamicResource IconFontAwesome}"
                                 FontSize="13"
                                 Foreground="#607d8b"
                                 VerticalAlignment="Center"
                                 Margin="4,0,0,0" />
                      <StackPanel Grid.Column="1"
                                  Margin="4,0,4,0"
                                  VerticalAlignment="Center"
                                  Spacing="0">
                        <TextBlock Classes="SessionName"
                                   Text="{Binding Name}"
                                   FontSize="11" />
                        <TextBlock Classes="SessionDetail"
                                   Text="{Binding Detail}"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Classes="SessionDetail"
                                 Text="{Binding TimeText}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,4,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="暂无最近会话"
                       FontSize="12"
                       Foreground="{DynamicResource WindowTextBrush}"
                       Margin="4,8,4,0"
                       VerticalAlignment="Top"
                       IsVisible="{Binding !HasHistory}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
