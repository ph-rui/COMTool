<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="using:COMTool.App.ViewModels.Tools"
        x:Class="COMTool.App.Views.PortScanWindow"
        x:DataType="tools:PortScanWindowViewModel"
        Title="网络扫描"
        Width="820"
        Height="480"
        MinWidth="640"
        MinHeight="380"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontSize="12">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
    <!-- IP 地址 / 扫描范围 -->
    <Border Grid.Row="0"
            Background="{DynamicResource SidebarListBackgroundBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="12,10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="IP 地址:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Foreground="{DynamicResource WindowTextBrush}" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Name="PortScanIpBox"
                 Text="{Binding Ip}"
                 Width="260"
                 HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="14"
                    Margin="0,10,0,0"
                    VerticalAlignment="Center">
          <RadioButton Name="PortScanKnownRadio"
                       GroupName="PortScanMode"
                       IsChecked="True"
                       Content="仅扫描已知端口"
                       FontSize="12" />
          <RadioButton Name="PortScanRangeRadio"
                       GroupName="PortScanMode"
                       IsChecked="{Binding RangeMode, Mode=TwoWay}"
                       Content="扫描端口范围"
                       FontSize="12" />
          <TextBox Name="PortScanFromBox"
                   Text="{Binding From}"
                   Width="64"
                   HorizontalContentAlignment="Center"
                   IsEnabled="{Binding RangeMode}" />
          <TextBlock Text="--&gt;" VerticalAlignment="Center" />
          <TextBox Name="PortScanToBox"
                   Text="{Binding To}"
                   Width="64"
                   HorizontalContentAlignment="Center"
                   IsEnabled="{Binding RangeMode}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
          <Button Name="PortScanStartButton"
                  Classes="SidebarActionButton"
                  Padding="14,5"
                  IsEnabled="{Binding !IsScanning}"
                  Click="OnStartScanClick">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="&#xf04b;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="11"
                         Foreground="White"
                         VerticalAlignment="Center" />
              <TextBlock Text="Start scan" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="PortScanStopButton"
                  Classes="SidebarActionButton"
                  Padding="14,5"
                  IsEnabled="{Binding IsScanning}"
                  Click="OnStopScanClick"
                  ToolTip.Tip="停止">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="&#xf28d;"
                         FontFamily="{DynamicResource IconFontAwesome}"
                         FontSize="11"
                         Foreground="White"
                         VerticalAlignment="Center" />
              <TextBlock Text="停止" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status / error -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,6,2,0">
      <TextBlock Text="{Binding Status}"
                 Foreground="{DynamicResource SidebarSectionBrush}"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Error}"
                 Foreground="#c62828"
                 Margin="10,0,0,0"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Results: "- Port #22 (ssh): listening" -->
    <Border Grid.Row="2"
            Margin="0,6,0,0"
            Background="{DynamicResource SidebarListBackgroundBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="2">
      <TextBox Name="PortScanResultBox"
               Text="{Binding Result}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
               FontSize="12"
               BorderThickness="0"
               Background="Transparent"
               VerticalContentAlignment="Top"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Border>

    <Button Grid.Row="3"
            Name="PortScanCloseButton"
            Classes="SidebarActionButton"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Padding="18,5"
            Click="OnCloseClick">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="&#xf00d;"
                   FontFamily="{DynamicResource IconFontAwesome}"
                   FontSize="11"
                   Foreground="White"
                   VerticalAlignment="Center" />
        <TextBlock Text="关闭" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</Window>
