<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:COMTool.App.ViewModels"
             xmlns:views="using:COMTool.App.Views"
             xmlns:sftp="using:COMTool.Sftp"
             x:Class="COMTool.App.Views.SftpPane"
             x:DataType="vm:SftpPaneViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- The toolbar of the drawer. The remote side is the side that is
         worked on, the local side is the source of an upload and the
         target of a download. -->
    <Border Grid.Row="0"
            Background="#f4f4f4"
            BorderBrush="#d4d4d4"
            BorderThickness="0,0,0,1"
            Padding="3">
      <WrapPanel Orientation="Horizontal">
        <Button Name="UpButton" Content="Up" Margin="0,0,4,0" Click="OnUpClick" />
        <Button Name="RefreshButton" Content="Refresh" Margin="0,0,8,0" Click="OnRefreshClick" />
        <Button Name="NewFolderButton" Content="New folder" Margin="0,0,4,0" Click="OnNewFolderClick" />
        <TextBox Name="NewFolderNameBox"
                 Width="110"
                 Margin="0,0,8,0"
                 PlaceholderText="new folder"
                 TextChanged="OnNewFolderNameChanged" />
        <Button Name="DeleteButton" Content="Delete" Margin="0,0,4,0" Click="OnDeleteClick" />
        <Button Name="RenameButton" Content="Rename" Margin="0,0,4,0" Click="OnRenameClick" />
        <TextBox Name="RenameNameBox"
                 Width="110"
                 Margin="0,0,8,0"
                 PlaceholderText="new name"
                 KeyDown="OnRenameNameKeyDown" />
        <Button Name="ChmodButton" Content="chmod" Margin="0,0,8,0" Click="OnChmodClick" />
        <Button Name="UploadButton"
                Content="Upload"
                Margin="0,0,4,0"
                IsEnabled="{Binding CanUpload}"
                Click="OnUploadClick" />
        <Button Name="DownloadButton"
                Content="Download"
                Margin="0,0,8,0"
                IsEnabled="{Binding CanDownload}"
                Click="OnDownloadClick" />
        <CheckBox Name="FollowLinksCheckBox"
                  Content="Follow symbolic links"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding FollowSymbolicLinks}" />
        <CheckBox Name="ShowHiddenCheckBox"
                  Content="Show hidden"
                  VerticalAlignment="Center"
                  IsChecked="{Binding ShowHidden}" />
      </WrapPanel>
    </Border>

    <!-- The remote side above, the local side below: the panel is narrow,
         so the two sides share the height instead of the width. -->
    <Grid Grid.Row="1" RowDefinitions="*,*">
      <Grid Name="RemotePaneGrid" Grid.Row="0" RowDefinitions="Auto,*" Margin="0,0,0,2">
        <TextBox Name="RemotePathBox"
                 Grid.Row="0"
                 Margin="3"
                 Text="{Binding RemotePath, Mode=TwoWay}"
                 KeyDown="OnRemotePathKeyDown" />
        <ListBox Name="RemoteList"
                 Grid.Row="1"
                 ItemsSource="{Binding RemoteEntries}"
                 SelectedItem="{Binding SelectedRemoteEntry}"
                 DoubleTapped="OnRemoteListDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="sftp:SftpEntry">
              <Grid ColumnDefinitions="*,64,112,80">
                <TextBlock Grid.Column="0"
                           Text="{Binding Converter={x:Static views:SftpEntryNameConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Converter={x:Static views:SftpEntrySizeConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Converter={x:Static views:SftpEntryTimeConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Converter={x:Static views:SftpEntryPermissionConverter.Instance}}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Name="LocalPaneGrid" Grid.Row="1" RowDefinitions="Auto,*">
        <TextBox Name="LocalPathBox"
                 Grid.Row="0"
                 Margin="3"
                 Text="{Binding LocalPath, Mode=TwoWay}"
                 KeyDown="OnLocalPathKeyDown" />
        <ListBox Name="LocalList"
                 Grid.Row="1"
                 ItemsSource="{Binding LocalEntries}"
                 SelectedItem="{Binding SelectedLocalEntry}"
                 DoubleTapped="OnLocalListDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="sftp:SftpEntry">
              <Grid ColumnDefinitions="*,64,112,80">
                <TextBlock Grid.Column="0"
                           Text="{Binding Converter={x:Static views:SftpEntryNameConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Converter={x:Static views:SftpEntrySizeConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Converter={x:Static views:SftpEntryTimeConverter.Instance}}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Converter={x:Static views:SftpEntryPermissionConverter.Instance}}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- The line that tells what happened, the progress of a transfer that
         runs and the question about a target that already exists. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Name="StatusText"
                   Text="{Binding StatusMessage}"
                   Margin="6,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Name="RetryButton"
                Content="Retry"
                Margin="4,0,4,0"
                IsVisible="{Binding HasRemoteError}"
                Click="OnRetryClick" />
        <ProgressBar Grid.Column="2"
                     Name="TransferProgressBar"
                     Width="120"
                     Height="12"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding TransferProgress}"
                     IsVisible="{Binding IsTransferring}"
                     VerticalAlignment="Center" />
        <Button Grid.Column="3"
                Name="CancelButton"
                Content="Cancel"
                Margin="4,0,4,0"
                IsVisible="{Binding IsTransferring}"
                Click="OnCancelClick" />
      </Grid>

      <!-- The question about a target that already exists. It sits inside
           the drawer, so the terminal stays usable while it is shown. -->
      <Border Grid.Row="1"
              Name="ConflictPanel"
              Background="#fff4ce"
              BorderBrush="#d8b45a"
              BorderThickness="1"
              Padding="6"
              IsVisible="{Binding IsConflictVisible}">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     Name="ConflictMessageText"
                     Text="{Binding ConflictMessage}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <TextBox Grid.Row="1"
                   Grid.Column="0"
                   Name="ConflictRenameBox"
                   Width="160"
                   HorizontalAlignment="Left"
                   Margin="0,4,0,0"
                   Text="{Binding ConflictRenameText, Mode=TwoWay}" />

          <CheckBox Grid.Row="2"
                    Grid.Column="0"
                    Name="ApplyToAllBox"
                    Content="Apply to all"
                    Margin="0,4,0,0"
                    IsChecked="{Binding ApplyToAll}" />
          <CheckBox Grid.Row="2"
                    Grid.Column="1"
                    Name="NeverAskAgainBox"
                    Content="Never ask again"
                    Margin="0,4,0,0"
                    IsChecked="{Binding NeverAskAgain}" />

          <Button Grid.Row="0"
                  Grid.Column="1"
                  Name="ConflictOverwriteButton"
                  Content="Overwrite"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnConflictOverwriteClick" />
          <Button Grid.Row="0"
                  Grid.Column="2"
                  Name="ConflictSkipButton"
                  Content="Skip"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnConflictSkipClick" />
          <Button Grid.Row="0"
                  Grid.Column="3"
                  Name="ConflictRenameButton"
                  Content="Rename"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnConflictRenameClick" />
          <Button Grid.Row="0"
                  Grid.Column="4"
                  Name="ConflictCancelButton"
                  Content="Cancel"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnConflictCancelClick" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
